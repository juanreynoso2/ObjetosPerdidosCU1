# Configuración de PRODUCCIÓN. En el servidor: cp .env.produccion.example .env  y llena todo.
# El archivo .env NO se sube a GitHub.

# Dirección pública de la página (sin https://). Debe apuntar a la IP de este servidor.
DOMINIO=objetosperdidos.ejemplo.buap.mx

POSTGRES_DB=objetos_perdidos
POSTGRES_USER=opcu1
# Contraseña larga y única. Genera una con:  openssl rand -base64 32
POSTGRES_PASSWORD=

# Clave para firmar las sesiones de administración (mínimo 32 caracteres). Genera una con:  openssl rand -hex 32
JWT_SECRET=

# Reportes permitidos por minuto desde la misma conexión
LIMITE_REPORTES_POR_MINUTO=10

# Respaldo diario: hora (00-23) y días que se conservan en el servidor
HORA_RESPALDO=03
DIAS_A_CONSERVAR=30
